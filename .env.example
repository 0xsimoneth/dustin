# Dustin secrets for `dustin close --execute`. Testnet only. Copy to .env and fill in; .env is gitignored.
# Only `dustin close --execute` reads .env, and it takes nothing from it but the two variables below;
# every other line is ignored and nothing is copied into the process environment. A non-empty value
# already set in the environment takes precedence over .env.
# Never commit real values, and never pass a secret on the command line.

# Secret key (S...) of the account being closed.
DUSTIN_ACCOUNT_SECRET=

# Secret key (S...) of the fee sponsor that pays every fee-bump transaction.
# On testnet, fund a fresh account from Friendbot: https://friendbot.stellar.org/?addr=G...
DUSTIN_SPONSOR_SECRET=

# Network settings are not read from .env. Set them in the environment when you need them:
#   export DUSTIN_HORIZON_URL=https://horizon-testnet.stellar.org      (must serve the testnet)
#   export DUSTIN_EXPLORER_BASE=https://stellar.expert/explorer/testnet (base of explorer links)
