# Dustin configuration. Testnet only. Copy to .env and fill in; .env is gitignored.
# Never commit real values, and never pass a secret on the command line.

# Secret key (S...) of the account being closed. Only `dustin close --execute` reads it.
DUSTIN_ACCOUNT_SECRET=

# Secret key (S...) of the fee sponsor that pays every fee-bump transaction.
# On testnet, fund a fresh account from Friendbot: https://friendbot.stellar.org/?addr=G...
DUSTIN_SPONSOR_SECRET=

# Horizon endpoint. It must serve the Stellar testnet; anything else is refused.
DUSTIN_HORIZON_URL=https://horizon-testnet.stellar.org

# Base URL used for explorer links in plans and reports.
DUSTIN_EXPLORER_BASE=https://stellar.expert/explorer/testnet
