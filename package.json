{
  "name": "stellar-dustin",
  "version": "0.1.0",
  "description": "Plan and close messy Stellar testnet accounts with fee-bumped, sponsor-paid transactions.",
  "keywords": [
    "stellar",
    "account-merge",
    "fee-bump",
    "sponsorship",
    "testnet",
    "cli"
  ],
  "license": "MIT",
  "author": "0xsimoneth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xsimoneth/dustin.git"
  },
  "bugs": {
    "url": "https://github.com/0xsimoneth/dustin/issues"
  },
  "homepage": "https://github.com/0xsimoneth/dustin#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dustin": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run --project unit",
    "test:testnet": "vitest run --project testnet",
    "coverage": "vitest run --project unit --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postpack": "npm run check:package",
    "evidence:plan": "node scripts/evidence-plan.mjs",
    "evidence:check": "node scripts/evidence-check.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.1.0",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
